    font-size: 14px;

    margin-bottom: 14px;

    text-shadow: 0 3px 10px rgba(0,0,0,0.8);
}

/* Mobile */
@media(max-width: 600px){

    .manga-chapters{
        font-size: 12px;
        margin-bottom: 10px;
    }

}

