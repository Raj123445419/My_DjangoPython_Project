/* MODAL BACKGROUND BLUR */
.modal-content{
    background: rgba(10,10,10,0.88) !important;
    backdrop-filter: blur(12px);
    border: 2px solid rgba(0,255,255,0.3) !important;
    border-radius: 22px !important;
    overflow: hidden;
    box-shadow:
    0 0 20px rgba(0,255,255,0.2),
    0 0 40px rgba(255,0,255,0.15);
}

/* RESPONSIVE WIDTH */
.modal-dialog{
    max-width: 650px;
    width: 95%;
}

/* MODAL HEIGHT */
.modal-body{
    max-height: 70vh;
    overflow-y: auto;
}

/* BACKGROUND IMAGE */
.modal-content::before{
    content:"";
    position:absolute;
    inset:0;
    background-image:url('../static/img/con1.png');
    background-size:cover;
    background-position:center;
    opacity:0.12;
    z-index:-1;
}

/* TITLE */
.popup-title{
    color:#fff;
    font-size:32px;
    font-weight:700;
    letter-spacing:1px;
    text-shadow:0 0 10px cyan;
}

/* OPTION BUTTONS */
.popup-btn{
    width:100%;
    border:none;
    padding:16px;
    border-radius:14px;
    background:linear-gradient(135deg,#071b2a,#0d3b52);
    color:white;
    font-size:18px;
    font-weight:600;
    transition:0.4s;
    margin-bottom:15px;
    border:1px solid rgba(0,255,255,0.2);
}

.popup-btn:hover{
    transform:translateY(-4px) scale(1.02);
    background:linear-gradient(135deg,#00bcd4,#0077ff);
    color:white;
    box-shadow:
    0 0 15px rgba(0,255,255,0.6),
    0 0 30px rgba(0,119,255,0.4);
}

/* DELETE BUTTON */
.delete-btn{
    background:linear-gradient(135deg,#7a0000,#ff0000);
}

.delete-btn:hover{
    background:linear-gradient(135deg,#ff0000,#ff4d4d);
    box-shadow:
    0 0 15px rgba(255,0,0,0.6),
    0 0 30px rgba(255,0,0,0.4);
}

/* INPUTS */
.form-control{
    background:rgba(255,255,255,0.08) !important;
    border:1px solid rgba(255,255,255,0.2) !important;
    color:white !important;
    border-radius:14px !important;
    padding:14px !important;
    font-size:17px;
    transition:0.3s;
}

.form-control:focus{
    border:1px solid cyan !important;
    box-shadow:0 0 15px rgba(0,255,255,0.5) !important;
    background:rgba(255,255,255,0.12) !important;
}

/* PLACEHOLDER */
.form-control::placeholder{
    color:#cfcfcf;
}

/* TEXTAREA */
.suggestion-box{
    resize:none;
}

/* FOOTER BUTTONS */
.modal-footer .btn{
    border-radius:12px;
    padding:10px 25px;
    font-size:18px;
    transition:0.3s;
}

.modal-footer .btn-secondary:hover{
    transform:scale(1.05);
}

.modal-footer .btn-danger:hover{
    transform:scale(1.05);
    box-shadow:0 0 20px rgba(255,0,0,0.5);
}

/* CLOSE BUTTON */
.btn-close{
    filter:invert(1);
}

/* MOBILE RESPONSIVE */
@media(max-width:768px){

    .popup-title{
        font-size:24px;
    }

    .popup-btn{
        font-size:15px;
        padding:13px;
    }

    .modal-dialog{
        width:95%;
        margin:auto;
    }

    .modal-body{
        max-height:65vh;
    }

}






















/* ===================================================== */
/* ================= GLOBAL RESET ====================== */
/* ===================================================== */

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    background: #0b0b0b;
    font-family: Arial, Helvetica, sans-serif;
}

/* ===================================================== */
/* ================= MAIN GRID ========================= */
/* ===================================================== */

.card-grid{
    width: 100%;

    display: grid;

    /* Laptop = 4 Cards */
    grid-template-columns: repeat(4, 1fr);

    /* SPACE BETWEEN CARDS */
    gap: 35px;

    padding: 25px;

    overflow: visible !important;
}

/* ===================================================== */
/* ================= TABLET ============================ */
/* ===================================================== */

@media(max-width: 991px){

    .card-grid{
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

}

/* ===================================================== */
/* ================= MOBILE ============================ */
/* ===================================================== */

@media(max-width: 600px){

    .card-grid{
        grid-template-columns: repeat(2, 1fr);

        gap: 18px;

        padding: 14px;
    }

}

/* ===================================================== */
/* ================= CARD ============================== */
/* ===================================================== */

.cardbox{
    height: 440px;

    position: relative;

    border-radius: 18px;

    background: #000;

    overflow: visible !important;

    box-shadow: 0 10px 25px rgba(0,0,0,0.5);

    transition: 0.35s ease;

    margin-bottom: 30px;
}

/* Hover */
.cardbox:hover{
    transform: translateY(-5px);
    z-index: 100;
}

/* Tablet */
@media(max-width: 991px){

    .cardbox{
        height: 390px;
    }

}

/* Mobile */
@media(max-width: 600px){

    .cardbox{
        height: 300px;
        border-radius: 14px;
    }

}

/* ===================================================== */
/* ================= IMAGE BOX ========================= */
/* ===================================================== */

.imgbox{
    position: absolute;

    inset: 0;

    border-radius: inherit;

    overflow: hidden;

    z-index: 1;
}

/* Gradient Overlay */
.imgbox::after{
    content: '';

    position: absolute;

    inset: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,0.95) 15%,
        rgba(0,0,0,0.55) 45%,
        rgba(0,0,0,0.15) 70%,
        transparent 100%
    );

    z-index: 2;
}

/* Image */
.cardimg{
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.5s ease;
}

/* Zoom Hover */
.cardbox:hover .cardimg{
    transform: scale(1.08);
}

/* ===================================================== */
/* ================= CART ICON ========================= */
/* ===================================================== */

.cart-container{
    position: absolute;

    top: 15px;
    right: 15px;

    z-index: 9999;

    overflow: visible;
}

/* Mobile */
@media(max-width: 600px){

    .cart-container{
        top: 10px;
        right: 10px;
    }

}

/* Circle Button */
.tooltip{
    position: relative;

    width: 46px;
    height: 46px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;

    background: rgba(0,39,67,0.85);

    border: 2px solid #1eb1be;

    backdrop-filter: blur(8px);

    box-shadow: 0 5px 15px rgba(0,0,0,0.4);

    opacity: 0;
    visibility: hidden;

    transform: scale(0.6);

    overflow: visible;

    transition: 0.3s ease;
}

/* Mobile */
@media(max-width: 600px){

    .tooltip{
        width: 38px;
        height: 38px;
    }

}

.tooltip i{
    color: #1eb1be;
    font-size: 18px;

    transition: 0.3s ease;
}

/* Show Button */
.cardbox:hover .tooltip{
    opacity: 1;
    visibility: visible;

    transform: scale(1);
}

/* Hover */
.tooltip:hover{
    background: #1eb1be;
    border-color: #1eb1be;
}

.tooltip:hover i{
    color: #000;
}

/* ===================================================== */
/* ================= TOOLTIP TEXT ====================== */
/* ===================================================== */

.tooltiptext{
    position: absolute;

    bottom: 140%;
    left: 50%;

    transform: translateX(-50%) translateY(10px);

    width: 120px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(135deg, #08d1d3, #0a8cff);

    color: #fff;

    border-radius: 6px;

    font-size: 13px;
    font-weight: 600;

    white-space: nowrap;

    opacity: 0;
    visibility: hidden;

    z-index: 999999;

    transition: 0.3s ease;
}

/* Arrow */
.tooltiptext::after{
    content: '';

    position: absolute;

    top: 100%;
    left: 50%;

    transform: translateX(-50%);

    border-width: 7px;
    border-style: solid;

    border-color: #0a8cff transparent transparent transparent;
}

/* Show Tooltip */
.tooltip:hover .tooltiptext{
    opacity: 1;
    visibility: visible;

    transform: translateX(-50%) translateY(0);
}

/* ===================================================== */
/* ================= CONTENT =========================== */
/* ===================================================== */

.cardcontent{
    position: absolute;

    bottom: 0;
    left: 0;

    width: 100%;

    z-index: 5;

    padding: 18px;

    display: flex;
    flex-direction: column;
}

/* Mobile */
@media(max-width: 600px){

    .cardcontent{
        padding: 12px;
    }

}

/* ===================================================== */
/* ================= TITLE ============================= */
/* ===================================================== */

.manga-name{
    color: #1eb1be;

    font-size: 22px;
    font-weight: 700;

    margin-bottom: 6px;

    text-shadow: 0 3px 10px rgba(0,0,0,0.8);

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Mobile */
@media(max-width: 600px){

    .manga-name{
