            .manga-chapters { font-size: 12px; margin-bottom: 10px; }
            .buttonbox { gap: 6px; flex-direction: column; }
            .readbtn, .buybtn { height: 34px; font-size: 11px; border-radius: 6px; }
            .buytooltip { display: none !important; } /* Stops modal/popup breakdowns on mobile */
            .f1 { font-size: 20px; }
        }

        .swiper, .swiper-wrapper, .swiper-slide, .owl-carousel, .owl-stage-outer { overflow: visible !important; }
    </style>
</head>

