      <div class="modal-body">
        <button type="button" class="popup-btn reason-btn" data-reason="1. I no longer use this account" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">I no longer need this account</button>
        <button type="button" class="popup-btn reason-btn" data-reason="2. I found a better alternative website/app" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">I found a better alternative website/app</button>
        <button type="button" class="popup-btn reason-btn" data-reason="3. I am facing technical issues or bugs" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">I am facing technical issues or bugs</button>
        <button type="button" class="popup-btn reason-btn" data-reason="4. I am concerned about privacy and security" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">I am concerned about privacy and security</button>
        <button type="button" class="popup-btn reason-btn" data-reason="5. The available content or features are insufficient" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">The available content or features are insufficient</button>
        <button type="button" class="popup-btn reason-btn" data-reason="6. Other" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#deleteModal">Other</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content position-relative">
      <div class="modal-header border-0">
        <h3 class="popup-title">Delete Account</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/DeleteAccount/" method="POST">
        {% csrf_token %}
        <input type="hidden" name="reason" id="selectedReason"> 

        <div class="modal-body">
          <textarea name="suggestion" class="form-control mb-3" rows="4" placeholder="Any suggestion so I can improve my website and make your experience better?" style="resize: none;" required></textarea>
          <input type="email" name="email" placeholder="Enter Email" class="form-control mb-3" required>
          <input type="password" name="password" placeholder="Enter Password" class="form-control mb-3" required>
          <input type="text" name="phnumber" placeholder="Enter Phone Number" class="form-control" required>
        </div>

        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Proceed</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Auto Dismiss Engine for Message Banner Systems
  setTimeout(function(){
    let alerts = document.querySelectorAll('.myalert');
    alerts.forEach(function(alert){
      alert.style.opacity = "0";
      alert.style.transform = "translateY(-20px)";
      setTimeout(function(){
        alert.remove();
      }, 500);
    });
  }, 5000);

  // Secure Transmission of Reason Payload Values between Modals
  document.addEventListener("DOMContentLoaded", function(){
    document.querySelectorAll('.reason-btn').forEach(btn => {
      btn.addEventListener('click', function(){
        document.getElementById('selectedReason').value = this.getAttribute('data-reason');
      });
    });
  });
</script>

</body>
</html>

