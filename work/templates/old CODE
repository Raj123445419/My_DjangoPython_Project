        .btn-close { filter: invert(1) sepia(1) saturate(5) hue-rotate(140deg); }

        /* --- Main Adaptive Ultimate Responsive Cards Grid --- */
        .card-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 35px;
            padding: 25px 0;
            overflow: visible !important;
        }

        /* Responsive adjustments for extremely large systems (TVs / 4K monitors) */
        @media(min-width: 2000px) {
            .card-grid {
                grid-template-columns: repeat(5, 1fr);
                gap: 45px;
            }
            .cardbox { height: 550px !important; }
        }

        .cardbox {
            height: 440px;
            position: relative;
            border-radius: 18px;
            background: #000;
            overflow: visible !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            transition: 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .cardbox:hover {
            transform: translateY(-10px);
            z-index: 100;
            border-color: #00f0ff;
            box-shadow: 0 15px 35px rgba(0, 240, 255, 0.3);
        }

        .imgbox {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            overflow: hidden;
            z-index: 1;
        }

        .imgbox::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(5,11,26,0.98) 20%, rgba(0,0,0,0.4) 55%, transparent 100%);
            z-index: 2;
        }

        .cardimg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s ease;
        }

        .cardbox:hover .cardimg { transform: scale(1.1); }

        /* --- Cart Action System --- */
        .cart-container {
            position: absolute;
            top: 15px;
            right: 15px;
            z-index: 99;
            overflow: visible;
        }

        .tooltip {
            position: relative;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            background: rgba(5, 11, 26, 0.85);
            border: 2px solid #00f0ff;
            backdrop-filter: blur(8px);
            box-shadow: 0 5px 15px rgba(0, 0, 240, 0.3);
            opacity: 0;
            visibility: hidden;
            transform: scale(0.6);
            overflow: visible;
            transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .tooltip i { color: #00f0ff; font-size: 18px; transition: 0.3s ease; }
        .cardbox:hover .tooltip { opacity: 1; visibility: visible; transform: scale(1); }
        .tooltip:hover { background: #00f0ff; border-color: #00f0ff; box-shadow: 0 0 15px #00f0ff; }
        .tooltip:hover i { color: #000; }

        .tooltiptext {
            position: absolute;
            bottom: 140%;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            width: 120px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #00f0ff, #0072ff);
            color: #fff;
            border-radius: 6px;
            font-family: 'Orbitron', sans-serif;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            z-index: 999999;
            transition: 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,240,255,0.4);
        }

        .tooltiptext::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 7px;
            border-style: solid;
            border-color: #0072ff transparent transparent transparent;
        }

        .tooltip:hover .tooltiptext { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

        /* --- Product Card Typography & Content --- */
        .cardcontent {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 5;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .manga-name {
            color: #ffffff;
            font-family: 'Orbitron', sans-serif;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: color 0.3s;
        }
        .cardbox:hover .manga-name {
            color: #00f0ff;
        }

        .manga-chapters {
            color: #a5a5a5;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 16px;
        }

        .buttonbox { width: 100%; display: flex; gap: 12px; }
        .readbtn, .buy-wrapper { flex: 1; }
        
        .readbtn, .buybtn {
            width: 100%;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .readbtn { 
            background: rgba(255, 255, 255, 0.08); 
            color: #fff; 
            border: 1px solid rgba(255,255,255,0.2);
        }
        .readbtn:hover { 
            background: #ffffff; 
            color: #050b1a; 
            box-shadow: 0 0 15px rgba(255,255,255,0.4);
            transform: translateY(-2px);
        }
        
        .buy-wrapper { position: relative; }
        .buybtn { 
            background: rgba(0, 240, 255, 0.05); 
            border: 1px solid #00f0ff; 
            color: #00f0ff; 
        }
        .buybtn:hover { 
            background: #00f0ff; 
            color: #000; 
            box-shadow: 0 0 15px #00f0ff;
            transform: translateY(-2px);
        }

        .buytooltip {
            position: absolute;
            bottom: 135%;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            width: 110px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ff0055, #990033);
            color: #fff;
            border-radius: 6px;
            font-family: 'Orbitron', sans-serif;
            font-size: 13px;
            font-weight: 700;
            opacity: 0;
            visibility: hidden;
            z-index: 999999;
            transition: 0.3s ease;
            box-shadow: 0 5px 15px rgba(255,0,85,0.4);
        }

        .buytooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 7px;
            border-style: solid;
            border-color: #990033 transparent transparent transparent;
        }

        .buybtn:hover + .buytooltip { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

        /* --- Pagination Layout Styles --- */
        .pb { 
            background: rgba(0, 240, 255, 0.1) !important; 
            border: 1px solid rgba(0, 240, 255, 0.3) !important; 
            color: #00f0ff !important;
            transition: all 0.3s ease;
        }
        .pc { color: #00f0ff !important; }
        .pb:hover { 
            background: #00f0ff !important; 
            color: #050b1a !important;
            box-shadow: 0 0 15px rgba(0,240,255,0.5);
            transform: translateY(-2px);
        }

        /* --- Footer Styles --- */
        .foot {
            background-image: url(../static/img/f.png);
            height: auto;
            width: 100%;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            background-color: #050b1a;
            border-top: 1px solid rgba(0, 240, 255, 0.2);
        }

        /* --- RESPONSIVE MATRIX ENGINE & NAVBAR/FOOTER CONFLICT FIX --- */
        
        /* 3) Strict Isolation Logic: Prevents Header Toggler from breaking or opening Footer Content */
        #collapsibleNavbar {
            position: relative;
            z-index: 2090;
        }
        #collapsibleFooterNavbar {
            position: relative;
            z-index: 1010;
        }

        @media(max-width: 991px) {
            nav.navbar .navbar-collapse {
                background: rgba(5, 11, 26, 0.96) !important;
                backdrop-filter: blur(20px) !important;
                -webkit-backdrop-filter: blur(20px) !important;
                padding: 25px !important;
                border: 1px solid rgba(0, 240, 255, 0.2) !important;
                border-radius: 15px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.8) !important;
                margin-top: 15px !important;
            }
            .navbar-nav .nav-item { margin: 8px 0; width: 100%; text-align: center; }
            .navbar-nav .nav-link { display: block; padding: 10px !important; }
            
            /* Explicit isolation override under small screens to completely lock boundaries */
            #collapsibleFooterNavbar.collapse.show {
                display: block !important;
                visibility: visible !important;
            }
        }

        @media(max-width: 768px) {
            .carousel-item { height: 55vh; min-height: 400px; }
            .carousel-caption { bottom: 5%; padding: 15px; max-width: 90%; }
            .popup-title { font-size:22px; }
            .popup-btn { font-size:16px; padding:12px; }
            .modal-dialog { width:92%; margin: 20px auto; }
            .modal-body { max-height:60vh; }
        }

        @media(max-width: 576px) {
            .card-grid { 
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); 
                gap: 15px; 
                padding: 10px 0; 
            }
            .cardbox { height: 290px; border-radius: 12px; margin-bottom: 15px; }
            .cart-container { top: 8px; right: 8px; }
            .tooltip { width: 35px; height: 35px; opacity: 1; visibility: visible; transform: scale(1); background: rgba(5, 11, 26, 0.9); }
